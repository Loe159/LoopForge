/* Semantic tokens shared by the initial Textual screens. */

#home-dashboard {
    display: block;
    height: 1fr;
    overflow: hidden;
    background: #15121B;
    color: #E7E0ED;
}

#home-header {
    width: 1fr;
    height: 3;
    padding: 0;
    overflow: hidden;
    scrollbar-visibility: hidden;
    border-bottom: solid #494454;
    background: #15121B;
}

#home-brand {
    width: auto;
    min-width: 18;
    height: 2;
    margin-left: 2;
}

#home-product-name {
    height: 1;
    color: #D0BCFF;
    text-style: bold;
}

#home-version {
    height: 1;
    color: #C7C6C6;
}

#home-summary {
    width: 1fr;
    height: 2;
    margin-right: 2;
    content-align: right middle;
    text-align: right;
    color: #CBC3D7;
}

.home-panel {
    overflow: hidden;
    scrollbar-visibility: hidden;
    background: #15121B;
    border: solid #808080;
    border-title-color: #808080;
    border-title-background: #15121B;
}

.home-panel.focused {
    border: solid #8B5CF6;
    border-title-color: #D0BCFF;
}

#home-metrics {
    height: 6;
    margin: 0 2;
    padding: 0;
    background: #0F0D15;
    border: solid #494454;
    border-title-background: #0F0D15;
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 2 2;
    grid-gutter: 0 2;
}

.home-metric {
    height: 2;
    padding: 0 1;
}

.home-metric-label {
    height: 1;
    color: #958EA0;
}

.home-metric-value {
    height: 1;
    color: #D0BCFF;
}

#home-columns {
    height: 1fr;
    margin: 1 2 0 2;
}

.home-list-panel {
    width: 1fr;
    height: 1fr;
    padding: 0;
}

#home-project-panel {
    margin-right: 1;
}

#home-run-panel {
    margin-left: 1;
}

#home-project-list, #home-run-list {
    height: 1fr;
    overflow-x: hidden;
    overflow-y: auto;
    background: #15121B;
    color: #E7E0ED;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-visibility: visible;
    scrollbar-background: #15121B;
    scrollbar-color: #494454;
    scrollbar-color-hover: #8B5CF6;
    scrollbar-color-active: #D0BCFF;
}

#home-project-list .option-list--option,
#home-run-list .option-list--option {
    padding: 0 1;
}

#home-project-list .option-list--option-highlighted {
    background: #2C2832;
    color: #E7E0ED;
    text-style: none;
}

#home-run-list .option-list--option-highlighted {
    background: #15121B;
    color: #E7E0ED;
    text-style: none;
}

#home-project-panel.focused #home-project-list .option-list--option-highlighted,
#home-run-panel.focused #home-run-list .option-list--option-highlighted {
    background: #D0BCFF;
    color: #0A0A0A;
    text-style: none;
}

#home-command-bar {
    height: 4;
    margin: 1 2 0 2;
    padding: 0;
    background: #1D1A23;
    border: solid #D0BCFF;
    border-title-color: #D0BCFF;
    border-title-background: #15121B;
}

#home-command-input {
    height: 1;
    padding: 0 1;
    border: none;
    background: #1D1A23;
    color: #E7E0ED;
}

#home-command-input:focus {
    background: #1D1A23;
    color: #D0BCFF;
}

#home-command-input .input--placeholder {
    color: #958EA0;
}

#home-command-hint {
    height: 1;
    padding: 0 1;
    color: #D0BCFF;
}

#home-hotkeys {
    height: 2;
    padding: 0 2;
    border-top: solid #494454;
    background: #0F0D15;
    color: #958EA0;
}

#home-hotkeys-left {
    width: 1fr;
    color: #CBC3D7;
}

#home-hotkeys-center {
    width: 2fr;
    text-align: center;
}

#home-hotkeys-right {
    width: 1fr;
    text-align: right;
    color: #CBC3D7;
}

/* Dedicated run Activity surface. The right context stays fixed while the
   left execution stream owns vertical scrolling. */
#run-dashboard {
    display: none;
    height: 1fr;
    overflow: hidden;
    background: #15121B;
    color: #E7E0ED;
}

#run-header {
    width: 1fr;
    height: 3;
    padding: 0;
    overflow: hidden;
    scrollbar-visibility: hidden;
    border-bottom: solid #494454;
    background: #15121B;
}

#run-header-brand {
    width: 15;
    height: 2;
    padding-left: 2;
    content-align: left middle;
    border-right: solid #494454;
}

#run-header-identity {
    width: 1fr;
    height: 1;
    padding-left: 2;
    content-align: left middle;
    text-overflow: ellipsis;
}

#run-header-branch {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    content-align: center middle;
    background: #1D1A23;
    color: #CBC3D7;
}

#run-header-status {
    width: auto;
    min-width: 22;
    height: 1;
    margin-right: 2;
    content-align: right middle;
    text-align: right;
}

#run-shell {
    height: 1fr;
    overflow: hidden;
}

#run-main {
    width: 1fr;
    height: 1fr;
    overflow: hidden;
}

#run-compact-context {
    display: none;
    height: 1;
    padding: 0 1;
    background: #0F0D15;
    color: #CBC3D7;
    text-overflow: ellipsis;
}

#run-compact-tabs {
    display: none;
    height: 1;
    padding: 0 1;
    overflow: hidden;
    background: #15121B;
    color: #958EA0;
    text-overflow: ellipsis;
}

#run-activity-feed {
    width: 1fr;
    height: 1fr;
    padding: 1;
    overflow-x: hidden;
    overflow-y: auto;
    background: #15121B;
    color: #E7E0ED;
    scrollbar-size: 1 1;
    scrollbar-visibility: visible;
    scrollbar-background: #15121B;
    scrollbar-color: #494454;
    scrollbar-color-hover: #8B5CF6;
    scrollbar-color-active: #D0BCFF;
}

#run-attempt-heading {
    height: 1;
    margin: 0 0 1 0;
    color: #FFB869;
}

.run-transcript-panel {
    width: 1fr;
    height: auto;
    min-height: 5;
    margin: 0 0 1 0;
    padding: 0 1;
    overflow: hidden;
    background: #15121B;
    border: solid #494454;
    border-title-color: #D0BCFF;
    border-title-background: #15121B;
}

#run-system-prompt-panel {
    min-height: 7;
}

#run-agent-output-panel {
    min-height: 6;
}

.run-tool-entry {
    height: auto;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

.run-tool-entry > CollapsibleTitle {
    width: 1fr;
    height: 1;
    padding: 0;
    color: #958EA0;
    text-style: none;
    text-overflow: ellipsis;
}

.run-tool-entry > CollapsibleTitle:focus {
    background: #2A2435;
    color: #D0BCFF;
}

.run-tool-entry > Contents {
    padding: 0 0 1 3;
    color: #958EA0;
}

.run-entry-message {
    margin: 1 0;
    padding: 0 1;
    border-left: solid #CBC3D7;
    color: #E7E0ED;
}

.run-entry-reasoning {
    margin: 1 0;
    color: #958EA0;
}

.run-entry-info {
    color: #958EA0;
}

#run-implementation-panel {
    min-height: 7;
    border: solid #A66500;
    border-title-color: #FFB869;
}

#run-system-prompt,
#run-agent-output,
#run-implementation-contract {
    width: 1fr;
    height: auto;
    color: #CBC3D7;
}

.run-panel {
    overflow: hidden;
    scrollbar-visibility: hidden;
    background: #1D1A23;
    border: solid #D0BCFF;
    border-title-color: #D0BCFF;
    border-title-background: #15121B;
}

#run-required-action {
    display: none;
    height: 5;
    margin: 0 2 1 2;
    padding: 0 1;
}

#run-action-title {
    height: 1;
    color: #D0BCFF;
    text-style: bold;
}

#run-action-description {
    height: 1;
    color: #CBC3D7;
    text-overflow: ellipsis;
}

#run-action-controls {
    height: 1;
    color: #E7E0ED;
}

#run-command-bar {
    height: 4;
    margin: 0 2 1 2;
    padding: 0;
}

#run-command-input {
    height: 1;
    padding: 0 1;
    border: none;
    background: #1D1A23;
    color: #E7E0ED;
}

#run-command-input:focus {
    background: #1D1A23;
    color: #D0BCFF;
}

#run-command-input .input--placeholder {
    color: #958EA0;
}

#run-command-hint {
    height: 1;
    padding: 0 1;
    color: #D0BCFF;
    text-overflow: ellipsis;
}

#run-context {
    width: 40;
    height: 1fr;
    padding: 0 1;
    overflow: hidden;
    background: #15121B;
    border-left: solid #494454;
}

#run-context-title {
    height: 3;
    padding: 1 0 0 0;
    border-bottom: solid #494454;
    color: #E7E0ED;
    text-style: bold;
}

#run-context-details {
    height: 1fr;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-visibility: visible;
    scrollbar-background: #15121B;
    scrollbar-color: #494454;
    scrollbar-color-hover: #8B5CF6;
    scrollbar-color-active: #D0BCFF;
}

.run-context-panel {
    width: 1fr;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    overflow: hidden;
    background: #15121B;
    border: solid #494454;
    border-title-color: #958EA0;
    border-title-background: #15121B;
}

#run-context-metrics-panel {
    height: 6;
}

#run-context-steps-panel {
    min-height: 5;
}

#run-context-configuration-panel {
    min-height: 7;
    margin-bottom: 1;
}

#run-context-metrics,
#run-context-steps,
#run-context-configuration {
    height: auto;
}

#run-view-tabs {
    height: 5;
    padding-top: 1;
    border-top: solid #494454;
}

#run-view-activity,
.run-view-disabled {
    height: 1;
    padding: 0 1;
}

#run-view-activity {
    background: #D0BCFF;
    color: #0A0A0A;
}

.run-view-disabled {
    color: #958EA0;
}

#run-hotkeys {
    height: 2;
    padding: 0 2;
    border-top: solid #494454;
    background: #0F0D15;
    color: #958EA0;
}

#run-hotkeys-left {
    width: 1fr;
}

#run-hotkeys-right {
    width: auto;
    min-width: 20;
    text-align: right;
    color: #CBC3D7;
}

Screen {
    background: $surface;
    color: $text;
}

/* Use the terminal-native ANSI surface for the complete chrome as well. */
Header, Footer {
    background: $surface;
    color: $text;
}

#main-content {
    display: none;
    height: 1fr;
    padding: 1 2;
    layout: vertical;
}

#screen-title {
    color: $accent;
    text-style: bold;
}

#screen-state, .secondary {
    color: $text-muted;
}

#screen-body {
    margin-top: 1;
    color: $text;
    height: 1fr;
    overflow-y: auto;
}

#screen-notice {
    margin-top: 1;
    color: $warning;
}

#operation-panel {
    height: auto;
    max-height: 10;
    margin-top: 1;
    border: round $accent;
    padding: 0 1;
    background: $panel;
}

#operation-status {
    color: $accent;
    text-style: bold;
}

#operation-log {
    height: auto;
    max-height: 7;
    overflow-y: auto;
}

#screen-help {
    margin-top: 1;
}

/* ScreenList: visible cursor highlight even without focus (can_focus=False). */
#screen-list {
    margin-top: 1;
    height: 1fr;
    overflow-y: auto;
}

#screen-list .option-list--option-highlighted {
    background: $boost;
    text-style: bold;
    color: $text;
}

#screen-list .option-list--option {
    padding: 0 1;
}

.error-title {
    color: $error;
    text-style: bold;
}

#error-dialog {
    width: 70%;
    max-width: 90;
    height: auto;
    padding: 1 2;
    border: round $error;
    background: $panel;
}

#error-message {
    margin: 1 0;
}

#confirmation-dialog, #entry-dialog, #adapter-dialog {
    width: 70%;
    max-width: 90;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}

.dialog-title {
    color: $accent;
    text-style: bold;
}

#confirmation-evidence, #entry-value {
    margin: 1 0;
}

#adapter-options, #adapter-args {
    margin: 1 0;
}

#adapter-options {
    height: 12;
}

.width-60 #main-content {
    padding: 0 1;
}

.width-60 #home-header {
    padding: 0;
}

.width-60 #home-brand {
    margin-left: 1;
}

.width-60 #home-summary {
    margin-right: 1;
}

.width-60 #home-metrics,
.width-60 #home-columns,
.width-60 #home-command-bar {
    margin-left: 1;
    margin-right: 1;
}

.width-60 #home-columns {
    layout: vertical;
}

.width-60 #home-project-panel,
.width-60 #home-run-panel {
    width: 1fr;
    height: 1fr;
    margin: 0;
}

.width-60 #home-summary {
    display: none;
}

.width-60 #home-hotkeys {
    padding: 0 1;
}

.width-60 #home-hotkeys-center {
    display: none;
}

.width-60 #run-header-brand {
    width: 12;
    padding-left: 1;
}

.width-60 #run-header-status,
.width-60 #run-header-branch,
.width-60 #run-context,
.width-80 #run-context {
    display: none;
}

.width-60 #run-compact-context,
.width-60 #run-compact-tabs,
.width-80 #run-compact-context,
.width-80 #run-compact-tabs {
    display: block;
}

.width-60 #run-activity-feed {
    padding: 1;
}

.width-60 #run-required-action,
.width-60 #run-command-bar {
    margin-left: 1;
    margin-right: 1;
}

.width-60 #run-hotkeys {
    padding: 0 1;
}

.width-60 #run-hotkeys-left {
    display: none;
}

.width-120 #run-context {
    width: 36;
}

.width-160 #run-context {
    width: 42;
}

.width-60 #operation-panel {
    max-height: 7;
    padding: 0;
}

.width-60 #operation-log {
    max-height: 4;
}

.width-60 Header, .width-60 Footer {
    display: none;
}

.width-80 #main-content {
    padding: 1 3;
}

.width-120 #main-content {
    padding: 2 6;
}

.width-160 #main-content {
    padding: 2 10;
}
